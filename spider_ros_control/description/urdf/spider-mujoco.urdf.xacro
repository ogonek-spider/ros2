<?xml version="1.0"?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffdrive_robot">
  <xacro:arg name="use_mock_hardware" default="false" />

  <xacro:include filename="$(find spider_description)/urdf/robot.urdf" />

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystem</plugin>
      <!-- <plugin>mock_components/GenericSystem</plugin> -->
    </hardware>

   <xacro:macro name="joint" params="leg_id motor_id">
    <joint name="${leg_id}-${motor_id}">
       <param name="leg_id">${leg_id}</param>
       <param name="motor_id">${motor_id}</param>
       <command_interface name="position"/>
       <state_interface name="position">
          <param name="initial_value">0</param>
       </state_interface>       
    </joint>
   </xacro:macro>      

   <xacro:macro name="pid_joint" params="leg_id motor_id">
    <joint name="${leg_id}-${motor_id}">
       <param name="leg_id">${leg_id}</param>
       <param name="motor_id">${motor_id}</param>
       <param name="position_kp">10000</param>
       <param name="position_ki">1</param>
       <param name="position_kd">10</param>
       <param name="position_i_max">10000</param>
       <command_interface name="position_pid"/>
       <state_interface name="position">
          <param name="initial_value">0</param>
       </state_interface>       
    </joint>
   </xacro:macro>
    
   <xacro:pid_joint leg_id="1" motor_id="1" />
   <xacro:pid_joint leg_id="1" motor_id="2" />
   <xacro:pid_joint leg_id="1" motor_id="3" />

   <xacro:pid_joint leg_id="2" motor_id="1" />
   <xacro:pid_joint leg_id="2" motor_id="2" />
   <xacro:pid_joint leg_id="2" motor_id="3" />

   <xacro:pid_joint leg_id="3" motor_id="1" />
   <xacro:pid_joint leg_id="3" motor_id="2" />
   <xacro:pid_joint leg_id="3" motor_id="3" />

   <xacro:pid_joint leg_id="4" motor_id="1" />
   <xacro:pid_joint leg_id="4" motor_id="2" />
   <xacro:pid_joint leg_id="4" motor_id="3" />

   <xacro:pid_joint leg_id="5" motor_id="1" />
   <xacro:pid_joint leg_id="5" motor_id="2" />
   <xacro:pid_joint leg_id="5" motor_id="3" />

   <xacro:pid_joint leg_id="6" motor_id="1" />
   <xacro:pid_joint leg_id="6" motor_id="2" />
   <xacro:pid_joint leg_id="6" motor_id="3" />

  </ros2_control>
</robot>