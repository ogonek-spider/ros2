<?xml version="1.0"?>
<!-- Basic differential drive mobile base -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diffdrive_robot">
  <xacro:arg name="use_mock_hardware" default="true" />

  <xacro:include filename="$(find spider_description)/urdf/robot.urdf" />

  <ros2_control name="Spider" type="system">
    <xacro:unless value="$(arg use_mock_hardware)">
    <hardware>
        <plugin>spider_ros_control/SpiderHardwareInterface</plugin>
        <param name="serial_port">/dev/tty.usbmodem101</param>
    </hardware>
    </xacro:unless>
    
    <xacro:if value="$(arg use_mock_hardware)">
    <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="calculate_dynamics">true</param>
    </hardware>
    </xacro:if>

   <xacro:macro name="joint" params="leg_id motor_id">
    <joint name="${leg_id}-${motor_id}">
       <param name="leg_id">${leg_id}</param>
       <param name="motor_id">${motor_id}</param>
       <command_interface name="position"/>
       <state_interface name="position">
          <param name="initial_value">0</param>
       </state_interface>       
    </joint>
   </xacro:macro>      
    
   <xacro:joint leg_id="1" motor_id="1" />
   <xacro:joint leg_id="1" motor_id="2" />
   <xacro:joint leg_id="1" motor_id="3" />

   <xacro:joint leg_id="2" motor_id="1" />
   <xacro:joint leg_id="2" motor_id="2" />
   <xacro:joint leg_id="2" motor_id="3" />

   <xacro:joint leg_id="3" motor_id="1" />
   <xacro:joint leg_id="3" motor_id="2" />
   <xacro:joint leg_id="3" motor_id="3" />

   <xacro:joint leg_id="4" motor_id="1" />
   <xacro:joint leg_id="4" motor_id="2" />
   <xacro:joint leg_id="4" motor_id="3" />

   <xacro:joint leg_id="5" motor_id="1" />
   <xacro:joint leg_id="5" motor_id="2" />
   <xacro:joint leg_id="5" motor_id="3" />

   <xacro:joint leg_id="6" motor_id="1" />
   <xacro:joint leg_id="6" motor_id="2" />
   <xacro:joint leg_id="6" motor_id="3" />

  </ros2_control>

</robot>